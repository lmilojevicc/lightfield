{
  "name": "lightfield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4",
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun tooling/dev-browsers.ts",
    "dev:browsers": "bun tooling/dev-browsers.ts",
    "build": "bun tooling/build.ts",
    "build:chromium": "bun tooling/build.ts chromium",
    "build:firefox": "bun tooling/build.ts firefox",
    "check": "bun --bun svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings && bun check --no-script -p tsconfig.tooling.json && bun check --no-script -p tsconfig.tests.json && bun check --no-script -p tsconfig.native-tests.json && bun check --no-script -p tsconfig.worker.json && bun check --no-script -p tsconfig.effects-tests.json && bun check --no-script -p tsconfig.ui-tests.json",
    "lint": "oxlint --type-aware --deny-warnings && bun --bun eslint 'src/**/*.svelte' --max-warnings 0",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "deadcode": "bun --bun knip",
    "test": "bun test tooling tests/shared tests/domain tests/platform tests/services tests/effects tests/ui",
    "inspect": "bun tooling/inspect.ts",
    "package": "bun tooling/package.ts",
    "lint:firefox": "bun --bun web-ext lint --source-dir dist/firefox --output text",
    "audit": "bun tooling/audit.ts",
    "validate": "bun run check && bun run lint && bun run format:check && bun run deadcode && bun run test && bun run build && bun run inspect && bun run package && bun run lint:firefox"
  },
  "dependencies": {
    "@paper-design/shaders": "0.0.82",
    "ogl": "1.0.11",
    "postprocessing": "6.39.5",
    "svelte": "5.57.3",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@puppeteer/browsers": "3.2.6",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/bun": "1.4.4",
    "@types/proper-lockfile": "4.1.4",
    "@types/three": "0.187.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "knip": "6.44.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "parse5": "8.0.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "proper-lockfile": "4.1.2",
    "proxy-agent": "8.0.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "web-ext": "10.8.0"
  },
  "overrides": {
    "basic-ftp": "6.2.3",
    "shell-quote": "1.12.0"
  }
}
